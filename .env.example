# Where bulk data goes (checkpoints, activation shards, videos). Kept out of git.
DATA_DIR=D:/AI/pacman-interp
# Hugging Face cache directory (huggingface_hub reads HF_HOME).
HF_HOME=D:/AI/hf_cache
# Number of parallel environment worker processes for rollouts.
NUM_WORKERS=12
# Torch device for the policy network.
DEVICE=cuda
# Silence the Windows no-symlink cache warning.
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Token file location if HF_HOME is not where `hf auth login` stored the token (optional)
# HF_TOKEN_PATH=~/.cache/huggingface/token
